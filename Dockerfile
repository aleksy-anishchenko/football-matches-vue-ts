# Используем официальный образ Node.js версии 20
FROM node:20-alpine

#Создаем директорию для приложения
WORKDIR /app

# Копируем файлы зависимостей
COPY package*.json ./

# Устанавливаем зависимости
RUN npm install

# Копируем все файлы и директории в контейнер
COPY . .

# Собираем приложение
RUN npm run build

# Указываем порт, который будет прослушиваться
EXPOSE 5173

# Определяем команду запуска
CMD ["npm", "run", "dev"]
